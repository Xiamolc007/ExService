{
  "name": "exwebsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --names web,mock-server --prefix-colors cyan,magenta \"pnpm --filter @workspace/web dev\" \"pnpm --filter @workspace/mock-server dev\"",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:generate": "openapi-typescript api/openapi.yaml -o packages/api-client/src/generated/schema.d.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @workspace/web build && pnpm --filter @workspace/mock-server build",
    "db:migrate": "pnpm --filter @workspace/mock-server db:migrate",
    "db:reset": "pnpm --filter @workspace/mock-server db:reset"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@workspace/mock-server": "workspace:*",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
