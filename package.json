{
  "name": "exwebsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/docs-integration/local-dev.mjs",
    "dev:outline": "node scripts/dev-app.mjs outline",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:generate": "openapi-typescript api/openapi.yaml -o packages/api-client/src/generated/schema.d.ts",
    "typecheck": "pnpm -r typecheck && pnpm exec tsc --noEmit -p tests/api-client/tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @workspace/sdk build && pnpm --filter @workspace/web build && pnpm --filter @workspace/server build",
    "db:migrate": "pnpm --filter @workspace/server db:migrate",
    "db:reset": "pnpm --filter @workspace/server db:reset",
    "sso:create": "pnpm --filter @workspace/server sso:create",
    "sso:inspect": "pnpm --filter @workspace/server sso:inspect",
    "auth:disable": "pnpm --filter @workspace/server auth:disable",
    "auth:enable": "pnpm --filter @workspace/server auth:enable",
    "integration:configure": "node scripts/docs-integration/command.mjs configure",
    "integration:init": "node scripts/docs-integration/command.mjs init",
    "integration:migrate": "node scripts/docs-integration/command.mjs migrate",
    "integration:up": "node scripts/docs-integration/command.mjs up",
    "integration:dev": "node scripts/docs-integration/command.mjs dev",
    "integration:down": "node scripts/docs-integration/command.mjs down",
    "integration:bootstrap": "node scripts/docs-integration/command.mjs bootstrap",
    "integration:test:outline": "node scripts/docs-integration/test-outline.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@workspace/server": "workspace:*",
    "@testcontainers/postgresql": "^11.9.0",
    "ajv": "^8.20.0",
    "@types/pg": "^8.15.2",
    "concurrently": "^10.0.5",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.16.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
