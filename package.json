{
  "name": "exwebsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "service:start": "node scripts/runtime/command.mjs start",
    "service:stop": "node scripts/runtime/command.mjs stop",
    "dev": "node scripts/runtime/command.mjs dev",
    "infra": "node scripts/runtime/command.mjs infra",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:generate": "openapi-typescript api/openapi.yaml -o packages/api-client/src/generated/schema.d.ts",
    "typecheck": "pnpm -r typecheck && pnpm exec tsc --noEmit -p tests/api-client/tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/runtime/build.mjs",
    "db:migrate": "pnpm --filter @workspace/server db:migrate",
    "db:reset": "pnpm --filter @workspace/server db:reset"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@workspace/server": "workspace:*",
    "@testcontainers/postgresql": "^11.9.0",
    "ajv": "^8.20.0",
    "@types/pg": "^8.15.2",
    "concurrently": "^10.0.5",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.16.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
