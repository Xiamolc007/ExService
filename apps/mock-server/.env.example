# 生成方式示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_CODE_HMAC_KEY=replace-with-64-hex-characters
# 仅经代理或隧道访问 Mock 时设置为浏览器可访问的完整地址。
# MOCK_PUBLIC_AVATAR_BASE_URL=https://example.test/api/avatars
# 邀请邮件链接使用的 HTTP(S) 站点根地址，默认 http://localhost:8081。
# 不允许凭据、子路径、query 或 hash。
# MOCK_PUBLIC_WEB_BASE_URL=http://localhost:8081
