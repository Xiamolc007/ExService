{
  "name": "@workspace/mock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app.ts",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-server-imports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reset": "tsx src/db/reset.ts && tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "sso:create": "node --env-file-if-exists=.env.local --import tsx src/cli/sso-create.ts",
    "sso:inspect": "node --env-file-if-exists=.env.local --import tsx src/cli/sso-inspect.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "ajv": "8.20.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.4",
    "sharp": "^0.35.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
