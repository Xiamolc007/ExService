# 生成方式示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/exre
AUTH_CODE_HMAC_KEY=replace-with-64-hex-characters
# 仅经代理或隧道访问 Server 时设置为浏览器可访问的完整地址。
# SERVER_PUBLIC_AVATAR_BASE_URL=https://example.test/api/avatars
# 集成模式可设置绝对头像目录与服务监听地址；普通本机开发保持默认值。
# SERVER_AVATAR_DIRECTORY=/absolute/path/to/avatars
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8080
# 邀请邮件链接使用的 HTTP(S) 站点根地址，默认 http://localhost:8081。
# 不允许凭据、子路径、query 或 hash。
# SERVER_PUBLIC_WEB_BASE_URL=http://localhost:8081
