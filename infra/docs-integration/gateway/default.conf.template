large_client_header_buffers 4 16k;
log_format integration_safe '$request_id $request_method $status $request_time';

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 8090 default_server;
  server_name _;
  access_log /var/log/nginx/access.log integration_safe;
  error_log /dev/stderr crit;
  return 421;
}

server {
  listen 8090;
  server_name exwebsite.test;
  access_log /var/log/nginx/access.log integration_safe;
  error_log /dev/stderr crit;

  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location = /docs { return 308 /docs/$is_args$args; }
  location ^~ /api/internal/ { return 404; }
  location ^~ /docs/internal/ { return 404; }

  location ^~ /api/ {
    proxy_pass http://${WEBSITE_SERVER_UPSTREAM};
  }

  location ^~ /docs/static/ {
    rewrite ^/docs/static/(.*)$ /${OUTLINE_STATIC_PREFIX}static/$1 break;
    proxy_pass http://${OUTLINE_STATIC_UPSTREAM};
    add_header Service-Worker-Allowed /docs/ always;
  }

  location ^~ /docs/ {
    proxy_pass http://${OUTLINE_BACKEND_UPSTREAM}/;
    proxy_read_timeout 3600s;
  }

  location / {
    proxy_pass http://${WEBSITE_WEB_UPSTREAM};
  }
}

server {
  listen 8090;
  server_name identity.exwebsite.test;
  access_log /var/log/nginx/access.log integration_safe;
  error_log /dev/stderr crit;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $remote_addr;

  location ~ ^/(?:\.well-known/(?:openid-configuration|jwks.json)|oauth2/(?:auth|token|revoke|userinfo|sessions/logout)|userinfo)(?:$|/) {
    proxy_pass http://hydra:4444;
  }
  location / { return 404; }
}
