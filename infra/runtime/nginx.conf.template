error_log stderr crit;
events {}
http {
  types { text/html html; text/css css; application/javascript js mjs; application/json json; image/svg+xml svg; image/png png; image/jpeg jpg jpeg; image/webp webp; font/woff2 woff2; }
  default_type application/octet-stream;
  log_format runtime_safe '$request_id $request_method $status $request_time';
  access_log /dev/stdout runtime_safe;
  # Request-level Nginx error messages may include authorization callback queries.
  error_log /dev/null;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  server {
    listen 443 ssl;
    server_name @@SITE_HOST@@;
    ssl_certificate @@SITE_CERT@@;
    ssl_certificate_key @@SITE_KEY@@;
    root @@SITE_ROOT@@;
    merge_slashes on;
    if ($uri ~ "[%\\\\]") { return 404; }
    location ~ ^/(api|docs)/internal(?:/|$) { return 404; }
    location = /docs { return 308 /docs/$is_args$args; }
    location /api/ {
      proxy_pass @@API_UPSTREAM@@;
      proxy_set_header Host @@SITE_HOST@@;
      proxy_set_header X-Forwarded-Host @@SITE_HOST@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /docs/ {
      proxy_pass @@OUTLINE_UPSTREAM@@;
      proxy_http_version 1.1;
      proxy_set_header Host @@SITE_HOST@@;
      proxy_set_header X-Forwarded-Host @@SITE_HOST@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Prefix /docs;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 300s;
    }
    location / { try_files $uri $uri/ /index.html; }
  }
  server {
    listen 443 ssl;
    server_name @@ISSUER_HOST@@;
    ssl_certificate @@ISSUER_CERT@@;
    ssl_certificate_key @@ISSUER_KEY@@;
    location ~ ^/(?:\.well-known/(?:openid-configuration|jwks.json)|oauth2/(?:auth|token|revoke|userinfo|sessions/logout)|userinfo)$ {
      proxy_pass @@HYDRA_UPSTREAM@@;
      proxy_set_header Host @@ISSUER_HOST@@;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { return 404; }
  }
}
