# Replace these TWO explicit domains with the validated deployment origin/issuer.
# Website files in /srv/exwebsite are the contents of apps/web/dist.
log_format runtime_safe '$request_id $request_method $status $request_time';
access_log /var/log/nginx/access.log runtime_safe;
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
server {
  listen 443 ssl;
  server_name site.example.invalid;
  ssl_certificate /etc/nginx/tls/site.crt;
  ssl_certificate_key /etc/nginx/tls/site.key;
  root /srv/exwebsite;
  merge_slashes on;
  # $uri is already decoded/normalized by nginx. Reject remaining escapes and backslashes.
  if ($uri ~ "[%\\\\]") { return 404; }
  location ~ ^/(api|docs)/internal(?:/|$) { return 404; }
  location = /docs { return 308 /docs/$is_args$args; }
  location /api/ {
    proxy_pass http://127.0.0.1:18080;
    proxy_set_header Host site.example.invalid;
    proxy_set_header X-Forwarded-Host site.example.invalid;
    proxy_set_header X-Forwarded-Proto https;
  }
  location /docs/ {
    proxy_pass http://127.0.0.1:13000/;
    proxy_http_version 1.1;
    proxy_set_header Host site.example.invalid;
    proxy_set_header X-Forwarded-Host site.example.invalid;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Prefix /docs;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
  }
  location / { try_files $uri $uri/ /index.html; }
}
server {
  listen 443 ssl;
  server_name issuer.example.invalid;
  ssl_certificate /etc/nginx/tls/issuer.crt;
  ssl_certificate_key /etc/nginx/tls/issuer.key;
  location ~ ^/(?:\.well-known/(?:openid-configuration|jwks.json)|oauth2/(?:auth|token|revoke|userinfo|sessions/logout)|userinfo)(?:$|/) {
    proxy_pass http://127.0.0.1:14444;
    proxy_set_header Host issuer.example.invalid;
    proxy_set_header X-Forwarded-Proto https;
  }
  location / { return 404; }
}
