# Copy to root .env.local. Actual secrets and local paths must never be committed.
RUNTIME_CONFIG_VERSION=2
RUNTIME_PROFILE=local
DATABASE_URL=
AUTH_CODE_HMAC_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:8080
HYDRA_PUBLIC_URL=http://127.0.0.1:14444/
LOCAL_PUBLIC_PORT=8080
LOCAL_WEB_PORT=8081
LOCAL_API_PORT=8082
LOCAL_OUTLINE_PORT=3102
LOCAL_OUTLINE_VITE_PORT=3101
LOCAL_POSTGRES_PORT=17432
LOCAL_REDIS_PORT=17379
LOCAL_HYDRA_PUBLIC_PORT=14444
LOCAL_HYDRA_ADMIN_PORT=14447
VITE_API_BASE_URL=/api
# Fresh configure fills absent document secret keys. Empty keys are invalid.
# Existing installations: pnpm infra configure --import-existing (do not copy defaults over old targets).
# Optional Website storage/COS keys retain their existing Server contracts.
# SERVER_AVATAR_DIRECTORY=
# STORAGE_DEFAULT_ADAPTER=
# STORAGE_UPLOAD_HMAC_KEY=
# STORAGE_MAX_BYTES=
# STORAGE_PUBLIC_API_BASE_URL=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# IDENTITY_OUTBOX_TARGETS_JSON=
# Optional tool overrides: INTEGRATION_NODE_BIN, INTEGRATION_COREPACK_JS, EXUI_SOURCE_DIR.
# Deployment: set RUNTIME_PROFILE=deployment, explicit PUBLIC_ORIGIN and HYDRA_PUBLIC_URL (HTTPS),
# HYDRA_ADMIN_URL, WEBSITE_INTERNAL_URL, OUTLINE_INTERNAL_URL, OUTLINE_DATABASE_URL,
# HYDRA_DATABASE_URL, OUTLINE_REDIS_URL, OUTLINE_STORAGE_DIRECTORY (absolute container path),
# and all document secret keys listed in docs/runtime.md. Missing inputs are rejected.
