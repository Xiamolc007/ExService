# Root runtime configuration. Copy to .env.local for a NEW installation only.
# Existing environment: pnpm infra convert (preserves original endpoints and credentials).
# Never overwrite existing database targets, secrets or storage paths with this template.
# Supported process environment variables take precedence over this file.
# Actual secrets and local paths must never be committed. See docs/runtime.md.

# --- Runtime mode ---
# No hand-managed version or configuration receipt.
RUNTIME_PROFILE=local

# --- Website database and authentication (required) ---
# Use the existing, independent PostgreSQL exre database; configure does not create it.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=exre
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=disable
# Optional connection semantics, preserved by explicit URL conversion:
# DATABASE_SSLROOTCERT=
# DATABASE_CONNECT_TIMEOUT=
# DATABASE_OPTIONS=
OUTLINE_DATABASE_HOST=127.0.0.1
OUTLINE_DATABASE_PORT=5432
OUTLINE_DATABASE_NAME=outline
OUTLINE_DATABASE_USER=outline
OUTLINE_DATABASE_PASSWORD=
OUTLINE_DATABASE_SSLMODE=disable
# OUTLINE_DATABASE_SSLROOTCERT=
# OUTLINE_DATABASE_CONNECT_TIMEOUT=
# OUTLINE_DATABASE_OPTIONS=
HYDRA_DATABASE_HOST=127.0.0.1
HYDRA_DATABASE_PORT=5432
HYDRA_DATABASE_NAME=hydra
HYDRA_DATABASE_USER=hydra
HYDRA_DATABASE_PASSWORD=
HYDRA_DATABASE_SSLMODE=disable
# HYDRA_DATABASE_SSLROOTCERT=
# HYDRA_DATABASE_CONNECT_TIMEOUT=
# HYDRA_DATABASE_OPTIONS=
# 64 hexadecimal characters; preserve the existing key for an existing installation.
AUTH_CODE_HMAC_KEY=

# --- Public entry points ---
# Use these canonical origins in the browser; local mode requires 127.0.0.1.
# Keep these URLs consistent with LOCAL_PUBLIC_PORT and LOCAL_HYDRA_PUBLIC_PORT.
PUBLIC_ORIGIN=http://127.0.0.1:8080
HYDRA_PUBLIC_URL=http://127.0.0.1:4444/

# --- Local application ports ---
# All nine local ports must be distinct. Public gateway, Website and Outline:
LOCAL_PUBLIC_PORT=8080
LOCAL_WEB_PORT=8081
LOCAL_API_PORT=8082
LOCAL_OUTLINE_PORT=3102
LOCAL_OUTLINE_VITE_PORT=3101

# --- Local background service ports ---
# PostgreSQL may host three independently owned databases; no cross-database access.
LOCAL_POSTGRES_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_HYDRA_PUBLIC_PORT=4444
LOCAL_HYDRA_ADMIN_PORT=4445
# Existing volume reuse requires reviewed maintenance, never automatic adoption.
# POSTGRES_VOLUME_NAME=
# POSTGRES_VOLUME_EXTERNAL=false
# REDIS_VOLUME_NAME=

# --- Document database and service secrets ---
# Ordinary passwords/client secret are plain text. Existing crypto keys keep their original values.
# Crypto keys below require 64 hexadecimal characters; UTILS_SECRET is a nonempty opaque secret.
# POSTGRES_PASSWORD=
# POSTGRES_USER=postgres
# OUTLINE_SECRET_KEY=
# OUTLINE_UTILS_SECRET=
# HYDRA_SYSTEM_SECRET=

# --- Website / Outline identity integration secrets ---
# OUTLINE_INTEGRATION_KEY=
# IDENTITY_BOOTSTRAP_KEY=
# IDENTITY_DELIVERY_KEY=
# IDENTITY_FLOW_KEY=
# OUTLINE_OIDC_CLIENT_SECRET=
# Optional additional identity delivery targets; see docs/runtime.md.
# IDENTITY_OUTBOX_TARGETS_JSON=

# --- Document attachments ---
# Optional absolute path; local default: .local/docs-integration/local-dev/data/outline/
# OUTLINE_STORAGE_DIRECTORY=

# --- Website avatars and HTTP settings (optional) ---
# Avatar directory must be absolute; public avatar URL must end in /api/avatars.
# SERVER_AVATAR_DIRECTORY=
# SERVER_PUBLIC_AVATAR_BASE_URL=
# SERVER_CORS_ALLOWED_ORIGINS=
# Optional 32-byte hex key for signed notification cursors and clear/read tokens.
# Omit to derive a separate subkey from AUTH_CODE_HMAC_KEY with domain separation.
# SERVER_NOTIFICATION_TOKEN_KEY=

# --- Website file storage (optional) ---
# Adapter: file or cos. Size limit is in bytes. API base must be an absolute HTTP(S) URL.
# STORAGE_DEFAULT_ADAPTER=
# STORAGE_MAX_BYTES=
# STORAGE_PUBLIC_API_BASE_URL=
# COS requires all four TENCENT_COS fields and a 64-hex upload HMAC key.
# STORAGE_UPLOAD_HMAC_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=

# --- Local tool overrides (optional) ---
# INTEGRATION_NODE_BIN=
# INTEGRATION_COREPACK_JS=

# --- Deployment-only settings ---
# Reference material; this project stage does not deploy publicly.
# Set RUNTIME_PROFILE=deployment, PUBLIC_ORIGIN and HYDRA_PUBLIC_URL to explicit HTTPS URLs.
# Supply all document secrets above and an absolute OUTLINE_STORAGE_DIRECTORY.
# Internal addresses use the selected private network; missing settings are rejected.
# HYDRA_ADMIN_URL=
# WEBSITE_INTERNAL_URL=
# OUTLINE_INTERNAL_URL=
# OUTLINE_REDIS_URL=
# Native Hydra must be v2.3.0. PM2_BINARY may point to the installed JS CLI on Windows.
# HYDRA_BINARY=
# PM2_BINARY=
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8082
# OUTLINE_HOST=127.0.0.1
# OUTLINE_PORT=3102
# HYDRA_LISTEN_HOST=127.0.0.1
# HYDRA_LISTEN_PUBLIC_PORT=4444
# HYDRA_LISTEN_ADMIN_PORT=4445
# RUNTIME_LOG_MAX_BYTES=10485760
# RUNTIME_LOG_RETAIN=5
# HYDRA_INTERNAL_PUBLIC_URL=http://127.0.0.1:4444/
# NGINX_BINARY=
# NGINX_SITE_CERT=
# NGINX_SITE_KEY=
# NGINX_ISSUER_CERT=
# NGINX_ISSUER_KEY=
