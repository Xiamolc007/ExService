{
  "name": "@workspace/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./http": {
      "types": "./dist/http-browser.d.ts",
      "browser": "./dist/http-browser.js",
      "node": "./dist/http-node.js",
      "default": "./dist/http-browser.js"
    },
    "./http/browser": {
      "types": "./dist/http-browser.d.ts",
      "default": "./dist/http-browser.js"
    },
    "./http/node": {
      "types": "./dist/http-node.d.ts",
      "default": "./dist/http-node.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && rollup -c rollup.config.dts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "axios": "1.20.0",
    "cos-js-sdk-v5": "^1.10.1",
    "cos-nodejs-sdk-v5": "^3.0.0"
  },
  "peerDependencies": {
    "@exre/exui": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@exre/exui": { "optional": true }
  },
  "devDependencies": {
    "@exre/exui": "^0.6.0",
    "@types/node": "^22.20.3",
    "@workspace/api-client": "workspace:*",
    "rollup": "^4.52.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
